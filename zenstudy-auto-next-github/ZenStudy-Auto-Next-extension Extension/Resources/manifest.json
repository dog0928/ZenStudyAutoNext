{
  "manifest_version": 3,
  "name": "ZEN Study Auto Next",
  "version": "0.3.0",
  "description": "ZEN Study の動画終了後に次の動画へ自動で移動します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.nnn.ed.nico/*",
    "https://*.nnn.ed.nico/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nnn.ed.nico/*",
        "https://*.nnn.ed.nico/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ZEN Study Auto Next",
    "default_popup": "popup.html"
  }
}
